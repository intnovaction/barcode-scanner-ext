{
  "manifest_version": 3,
  "name": "Emulador de pistola de códigos de barras",
  "version": "1.0.0",
  "description": "Simula una pistola lectora de ISBN/EAN: teclea el código en la página activa y termina con Enter.",
  "author": "IntNovAction",
  "homepage_url": "https://www.intnovaction.com",
  "action": {
    "default_title": "Emulador de pistola - abrir panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "leer-siguiente": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Leer el siguiente código en la página activa"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel", "scripting", "tabs"],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}

{
  "manifest_version": 3,
  "name": "Emulador de pistola de códigos de barras",
  "version": "1.0.0",
  "description": "Hace de pistola lectora de códigos de barras (ISBN/EAN) en tus páginas web: escribe el código en el campo y pulsa Enter, sin quitarle el foco a la aplicación.",
  "author": "IntNovAction",
  "homepage_url": "https://www.intnovaction.com",
  "action": {
    "default_title": "Emulador de pistola",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "opciones/opciones.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "leer-siguiente": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Leer el siguiente código"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "widget/*.js",
        "comun/*.js",
        "icons/*.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
